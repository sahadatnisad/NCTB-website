{
	"name": "nctb/learning-hub",
	"description": "NCTB AI Learning Hub — core learning and business logic plugin (curriculum, lessons, practice, mastery, revision, entitlements, AI tutor).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml.dist .",
		"lint:fix": "phpcbf --standard=phpcs.xml.dist ."
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
